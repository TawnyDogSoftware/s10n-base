# Development values that work with docker-compose.local.yml. Copy to .env to change them;
# `bun dev` and the `db:*`, `test:live` and `smoke` scripts read .env when it exists and this
# file otherwise. Variables already set in the shell win over both. Never commit .env.

# development, test or production.
NODE_ENV=development
# The single public origin users see. In development it is the Vite dev server, which proxies
# the API paths to the server. https is required in production.
APP_URL=http://localhost:5173
# Where the API server listens. The default without this file is 0.0.0.0, for containers.
HOST=127.0.0.1
PORT=4210
# A secret: it holds the database password. Never printed by the server.
DATABASE_URL=postgres://s10n_base:s10n_base@127.0.0.1:54320/s10n_base
DATABASE_POOL_MAX=10
# How many reverse proxies sit in front of the server (0 to 10). Sets which X-Forwarded-For
# entry is the client's address.
TRUSTED_PROXY_HOPS=0
REQUEST_BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
# debug, info, warn or error.
LOG_LEVEL=info

# Auth. A secret of at least 32 characters; this example value is refused in production.
# Generate a real one with: openssl rand -base64 32
BETTER_AUTH_SECRET=development-only-secret-replace-me-in-production
# development, preview or production: which mobile app build this server serves. Required in
# production.
APP_VARIANT=development

# Email. Sent through Amazon SES v2. Locally, SES_ENDPOINT points at the capture server
# (`bun run ses:local`, also started by `bun dev`), whose inbox is at that address.
EMAIL_FROM=no-reply@example.com
SUPPORT_EMAIL=support@example.com
SES_REGION=us-east-1
# Loopback only, and refused in production, where the regional AWS endpoint is always used.
SES_ENDPOINT=http://127.0.0.1:8005
# The capture server accepts only these placeholder keys, which production refuses.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Optional, for temporary credentials.
# AWS_SESSION_TOKEN=

# The web app's API origin, read at build time. Leave it unset when the server serves the web
# app or Vite proxies the API (the default); see docs/setup.md before setting it.
# VITE_API_BASE_URL=

# The live tests' database. Its name must end in _test; it never falls back to DATABASE_URL.
TEST_DATABASE_URL=postgres://s10n_base:s10n_base@127.0.0.1:54320/s10n_base_test
