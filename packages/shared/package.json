{
  "name": "@s10n-base/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-variants": {
      "types": "./src/app-variants.ts",
      "import": "./src/app-variants.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./src/auth.ts"
    },
    "./id": {
      "types": "./src/id.ts",
      "import": "./src/id.ts"
    },
    "./time": {
      "types": "./src/time.ts",
      "import": "./src/time.ts"
    }
  },
  "scripts": {
    "build": "tsdown src/app-variants.ts src/auth.ts src/id.ts src/time.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
