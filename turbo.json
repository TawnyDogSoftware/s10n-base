{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "APP_URL",
    "HOST",
    "PORT",
    "DATABASE_URL",
    "DATABASE_POOL_MAX",
    "TRUSTED_PROXY_HOPS",
    "REQUEST_BODY_LIMIT_BYTES",
    "SHUTDOWN_TIMEOUT_MS",
    "LOG_LEVEL",
    "BETTER_AUTH_SECRET",
    "APP_VARIANT",
    "EMAIL_FROM",
    "SUPPORT_EMAIL",
    "SES_REGION",
    "SES_ENDPOINT",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "TEST_DATABASE_URL",
    "VITE_SERVER_URL",
    "VITE_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}
