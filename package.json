{
  "name": "s10n-base",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.1.15",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.0",
      "@types/better-sqlite3": "^7.6.13",
      "@types/node": "^24.10.0",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2",
      "@types/ws": "^8.18.1",
      "@vitejs/plugin-react": "^5.1.0",
      "better-sqlite3": "^12.4.1",
      "effect": "4.0.0-beta.45",
      "electron": "40.6.0",
      "jsdom": "^26.1.0",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "tailwindcss": "^4.1.15",
      "tsdown": "^0.20.3",
      "turbo": "^2.5.8",
      "typescript": "^5.9.3",
      "vite": "^7.1.10",
      "vitest": "^4.0.3",
      "ws": "^8.18.3",
      "zustand": "^5.0.8",
      "@tanstack/react-query": "^5.90.5",
      "@tanstack/react-router": "^1.133.22"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@s10n-base/server --filter=@s10n-base/web",
    "dev:server": "turbo run dev --filter=@s10n-base/server",
    "dev:web": "turbo run dev --filter=@s10n-base/web",
    "dev:desktop": "turbo run dev --filter=@s10n-base/server --filter=@s10n-base/web --filter=@s10n-base/desktop",
    "start:server": "turbo run start --filter=@s10n-base/server",
    "start:web": "turbo run preview --filter=@s10n-base/web",
    "start:desktop": "turbo run start --filter=@s10n-base/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint . --report-unused-disable-directives",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "effect": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.3.9"
}
