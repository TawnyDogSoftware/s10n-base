{
  "name": "s10n-base",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.3.5",
      "@tanstack/react-query": "^5.107.1",
      "@tanstack/react-router": "^1.170.46",
      "@testing-library/dom": "^10.4.2",
      "@testing-library/jest-dom": "^7.0.1",
      "@testing-library/react": "^16.3.3",
      "@types/node": "^26.6.6",
      "@types/react": "~19.3.0",
      "@types/react-dom": "~19.3.0",
      "@vitejs/plugin-react": "^6.3.0",
      "@vitest/coverage-v8": "5.1.0",
      "effect": "4.1.4",
      "jsdom": "^31.0.1",
      "oxfmt": "0.78.0",
      "oxlint": "1.93.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tailwindcss": "^4.3.5",
      "tsdown": "^0.23.7",
      "turbo": "^2.11.11",
      "typescript": "~6.0.3",
      "vite": "^8.3.8",
      "vitest": "5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@s10n-base/server --filter=@s10n-base/web",
    "dev:server": "turbo run dev --filter=@s10n-base/server",
    "dev:web": "turbo run dev --filter=@s10n-base/web",
    "start:server": "turbo run start --filter=@s10n-base/server",
    "start:web": "turbo run preview --filter=@s10n-base/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "vitest run",
    "lint": "oxlint . --report-unused-disable-directives",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .turbo",
    "smoke": "bun scripts/smoke-built-server.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "effect": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.1"
  },
  "packageManager": "bun@1.4.4"
}
