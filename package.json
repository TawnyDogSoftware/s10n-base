{
  "name": "s10n-base",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@axe-core/playwright": "^4.14.0",
      "@better-auth/expo": "1.7.25",
      "@better-auth/passkey": "1.7.25",
      "@eslint/js": "^10.0.1",
      "@playwright/test": "1.65.1",
      "@tailwindcss/vite": "^4.3.5",
      "@tanstack/react-query": "^5.107.1",
      "@tanstack/react-router": "^1.170.46",
      "@testing-library/dom": "^10.4.2",
      "@testing-library/jest-dom": "^7.0.1",
      "@testing-library/react": "^16.3.3",
      "@types/node": "^26.6.6",
      "@types/pg": "^8.23.1",
      "@types/react": "~19.3.0",
      "@types/react-dom": "~19.3.0",
      "@vitejs/plugin-react": "^6.3.0",
      "@vitest/coverage-v8": "5.1.0",
      "better-auth": "1.7.25",
      "better-call": "1.4.5",
      "dependency-cruiser": "^18.7.2",
      "effect": "4.1.4",
      "eslint": "^10.15.0",
      "eslint-plugin-i18next": "^6.1.5",
      "eslint-plugin-sonarjs": "^4.2.2",
      "i18next": "^27.1.3",
      "jsdom": "^31.0.1",
      "knip": "^6.45.1",
      "kysely": "^0.29.9",
      "kysely-codegen": "^0.20.0",
      "oxfmt": "0.78.0",
      "oxlint": "1.93.0",
      "pg": "^8.23.1",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-i18next": "^18.0.2",
      "tailwindcss": "^4.3.5",
      "tsdown": "^0.23.7",
      "turbo": "^2.11.11",
      "typescript": "~6.0.3",
      "typescript-eslint": "^8.73.0",
      "uniwind": "^1.13.2",
      "vite": "^8.3.8",
      "vitest": "5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun scripts/with-env.ts turbo run dev --filter=@s10n-base/server",
    "dev:web": "bun scripts/with-env.ts turbo run dev --filter=@s10n-base/web",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "ios:simulator": "bun run --cwd apps/mobile ios:simulator",
    "ios:device": "bun run --cwd apps/mobile ios:device",
    "android": "bun run --cwd apps/mobile android",
    "mobile:export": "bun run --cwd apps/mobile export && bun scripts/mobile-bundle/check.ts apps/mobile/dist",
    "start:server": "bun scripts/with-env.ts turbo run start --filter=@s10n-base/server",
    "start:web": "turbo run preview --filter=@s10n-base/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "vitest run",
    "test:live": "bun scripts/with-env.ts vitest run --config apps/server/vitest.live.config.ts",
    "lint": "oxlint . --report-unused-disable-directives",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .turbo apps/mobile/.expo apps/mobile/ios apps/mobile/android",
    "smoke": "bun scripts/with-env.ts bun scripts/smoke-built-server.ts",
    "ses:local": "bun scripts/with-env.ts bun scripts/ses-local/main.ts",
    "deps:update": "bun scripts/dependency-updates/run.ts",
    "db:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.local.yml down",
    "db:migrate": "bun scripts/with-env.ts bun apps/server/src/migrate.ts up",
    "db:status": "bun scripts/with-env.ts bun apps/server/src/migrate.ts status",
    "db:reset": "bun scripts/with-env.ts bun apps/server/src/migrate.ts reset",
    "db:generate": "bun scripts/with-env.ts bun run --cwd apps/server db:generate",
    "db:generate:check": "bun scripts/with-env.ts bun run --cwd apps/server db:generate:check",
    "db:test:sweep": "bun scripts/with-env.ts bun apps/server/src/test/sweep.ts",
    "auth:set-role": "bun scripts/with-env.ts bun apps/server/src/set-role.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-i18next": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "effect": "catalog:",
    "minimatch": "^11.0.8"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.1"
  },
  "packageManager": "bun@1.4.4"
}
