# The mobile app's build-time settings. Copy to apps/mobile/.env.local (ignored by git); Expo
# reads it when Metro starts and when it builds. Variables set in your shell win. See
# docs/mobile-dev.md.

# development, preview or production: the app's name, URL scheme and bundle identifier. Each
# installs side by side with the others. Unset means development.
APP_VARIANT=development

# The API origin the app calls: scheme, host and port, with no path. Development may use plain
# http and defaults to http://localhost:4210, which an iOS simulator on the same Mac reaches. A
# physical phone needs your computer's address on the network instead, such as
# http://192.168.1.20:4210. Preview and production must set an https origin.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4210

# Set once you create an EAS project for the app (`eas init`). Optional.
# EAS_PROJECT_ID=
