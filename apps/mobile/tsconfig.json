{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "customConditions": ["react-native"],
    // Expo loads app.config.ts with Node, which needs the `.ts` extension on relative imports.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "app.config.ts", "vitest.config.ts", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
