{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Dead code (`bun run deadcode`). The normal pass counts tests as users of code, so it finds
  // unused files, exports and dependencies anywhere. The production pass (`--production`) starts
  // from the production entry points alone, marked `!`, and finds files and dependencies that
  // only tests and tools use. Test files and test support are left out of the production
  // project with a `!` after a negated pattern. See docs/quality.md.
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts", "e2e/**/*.ts", "*.{ts,mjs}"],
    },
    "apps/server": {
      // The live tests run with their own config (`bun run test:live`).
      "entry": ["vitest.live.config.ts"],
      "project": [
        "src/**/*.ts!",
        "*.ts",
        "!src/**/*.test.ts!",
        "!src/test/**!",
        // Checks only the tests run: the auth schema comparison (the live schema test) and the
        // contract-to-handler comparison (the registry test).
        "!src/auth/schema-check.ts!",
        "!src/rpc/registry.ts!",
      ],
      // The bundle inlines @s10n-base/i18n but keeps its i18next import external
      // (tsdown.config.ts), so the deployed server must install i18next itself.
      "ignoreDependencies": ["i18next"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}!", "*.ts", "!src/**/*.test.{ts,tsx}!", "!src/test/**!"],
    },
    "apps/mobile": {
      "project": [
        "src/**/*.{ts,tsx,css}!",
        "*.{ts,cjs}",
        "!src/**/*.test.{ts,tsx}!",
        "!src/test/**!",
      ],
      // Expo config plugins: app.config.ts names them, so they are used at build time, and
      // nothing in the app imports them.
      // - expo-dev-client: the development build's launcher and its URL scheme.
      // - expo-splash-screen: the native splash screen, from the plugin's options.
      "ignoreDependencies": ["expo-dev-client", "expo-splash-screen"],
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}!", "*.ts", "!src/**/*.test.{ts,tsx}!"],
    },
    "packages/client": {
      "project": [
        "src/**/*.{ts,tsx}!",
        "*.ts",
        "!src/**/*.test.{ts,tsx}!",
        // The fake fetch and the fake server the client, web and mobile tests share.
        "!src/test-fetch.ts!",
        "!src/testing/**!",
      ],
    },
  },
  // Generated by kysely-codegen; `bun run db:generate:check` keeps it in step with the schema.
  "ignore": ["apps/server/src/infra/postgres/generated/db.ts"],
}
